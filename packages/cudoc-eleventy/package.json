{
  "name": "cudoc-eleventy",
  "version": "0.2.0",
  "description": "Eleventy Markdown integration for cudoc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cudoment/cudoc.git",
    "directory": "packages/cudoc-eleventy"
  },
  "homepage": "https://github.com/cudoment/cudoc/tree/main/packages/cudoc-eleventy#readme",
  "bugs": {
    "url": "https://github.com/cudoment/cudoc/issues"
  },
  "keywords": [
    "cudoc",
    "eleventy",
    "11ty",
    "markdown",
    "documentation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@cudoment/cudoc": "0.2.0",
    "cudoc-markdown-it": "0.2.0",
    "gray-matter": "^4.0.3"
  },
  "peerDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0"
  },
  "author": "cudoment",
  "engines": {
    "node": ">=20"
  }
}
