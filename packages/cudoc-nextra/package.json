{
  "name": "cudoc-nextra",
  "version": "1.0.0",
  "description": "cudoc for Nextra: embed a section of one document in another, kept in step with its source, and write merged table cells, lists inside cells and variables in plain Markdown, keeping Nextra's own heading IDs and table of contents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cudoment/cudoc.git",
    "directory": "packages/cudoc-nextra"
  },
  "homepage": "https://github.com/cudoment/cudoc#readme",
  "bugs": {
    "url": "https://github.com/cudoment/cudoc/issues"
  },
  "keywords": [
    "cudoc",
    "nextra",
    "next",
    "mdx",
    "documentation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "cudoc-remark": "1.0.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "author": "cudoment",
  "engines": {
    "node": ">=22"
  }
}
