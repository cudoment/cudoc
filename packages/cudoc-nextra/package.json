{
  "name": "cudoc-nextra",
  "version": "0.2.0",
  "description": "Nextra adapter for cudoc: remark wiring and default components.",
  "keywords": [
    "cudoc",
    "nextra",
    "next",
    "mdx",
    "documentation"
  ],
  "homepage": "https://github.com/cudoment/cudoc/tree/main/packages/cudoc-nextra#readme",
  "bugs": {
    "url": "https://github.com/cudoment/cudoc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cudoment/cudoc.git",
    "directory": "packages/cudoc-nextra"
  },
  "license": "MIT",
  "author": "cudoment",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "cudoc-remark": "0.2.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
