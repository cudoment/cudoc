{
  "name": "cudoc-html",
  "version": "0.3.0",
  "description": "Build portable HTML documentation sites with cudoc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cudoment/cudoc.git",
    "directory": "packages/cudoc-html"
  },
  "homepage": "https://github.com/cudoment/cudoc/tree/main/packages/cudoc-html#readme",
  "bugs": {
    "url": "https://github.com/cudoment/cudoc/issues"
  },
  "keywords": [
    "cudoc",
    "html",
    "static-site",
    "markdown",
    "documentation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@cudoment/cudoc": "0.3.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "highlight.js": "^11.12.0"
  },
  "author": "cudoment",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cudoc-html": "./dist/cli.js"
  }
}
