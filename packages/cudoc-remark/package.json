{
  "name": "cudoc-remark",
  "version": "0.3.0",
  "description": "Remark plugin for cudoc: heading anchors, badges, table cell lists and table column layout, each configurable.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cudoment/cudoc.git",
    "directory": "packages/cudoc-remark"
  },
  "homepage": "https://github.com/cudoment/cudoc/tree/main/packages/cudoc-remark#readme",
  "bugs": {
    "url": "https://github.com/cudoment/cudoc/issues"
  },
  "keywords": [
    "cudoc",
    "remark",
    "remark-plugin",
    "mdx",
    "markdown",
    "mdast"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./prepare": {
      "types": "./dist/prepare.d.ts",
      "default": "./dist/prepare.js"
    },
    "./heading-ids": {
      "types": "./dist/heading-ids.d.ts",
      "default": "./dist/heading-ids.js"
    },
    "./host-plugins": {
      "types": "./dist/host-plugins.d.ts",
      "default": "./dist/host-plugins.js"
    },
    "./table-cell-list": {
      "types": "./dist/transforms/table-cell-list/index.d.ts",
      "default": "./dist/transforms/table-cell-list/index.js"
    },
    "./table-column-layout": {
      "types": "./dist/transforms/table-column-layout/index.d.ts",
      "default": "./dist/transforms/table-column-layout/index.js"
    },
    "./badge": {
      "types": "./dist/transforms/badge.d.ts",
      "default": "./dist/transforms/badge.js"
    },
    "./toc": {
      "types": "./dist/toc.d.ts",
      "default": "./dist/toc.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "default": "./dist/embed.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@cudoment/cudoc": "0.3.0",
    "estree-util-value-to-estree": "^3.5.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "remark-directive": "^4.0.0",
    "acorn": "^8.15.0",
    "remark-frontmatter": "^5.0.0"
  },
  "peerDependencies": {
    "@types/mdast": "^4.0.4",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/mdast": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "author": "cudoment",
  "engines": {
    "node": ">=20"
  }
}
