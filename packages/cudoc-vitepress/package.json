{
  "name": "cudoc-vitepress",
  "version": "1.0.0",
  "description": "cudoc for VitePress: embed a section of one document in another, kept in step with its source, and write merged table cells, lists inside cells and variables in plain Markdown, keeping VitePress's own rendering.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cudoment/cudoc.git",
    "directory": "packages/cudoc-vitepress"
  },
  "homepage": "https://github.com/cudoment/cudoc#readme",
  "bugs": {
    "url": "https://github.com/cudoment/cudoc/issues"
  },
  "keywords": [
    "cudoc",
    "vitepress",
    "vitepress-plugin",
    "markdown",
    "documentation",
    "markdown-it",
    "markdown-it-plugin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@cudoment/cudoc": "1.0.0",
    "cudoc-markdown-it": "1.0.0",
    "hast-util-from-html": "^2.0.3"
  },
  "peerDependencies": {
    "markdown-it": "^14.1.0",
    "vitepress": "^1.6.4",
    "@types/markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0"
  },
  "author": "cudoment",
  "engines": {
    "node": ">=22"
  },
  "peerDependenciesMeta": {
    "@types/markdown-it": {
      "optional": true
    }
  }
}
