{
  "name": "@cudoment/cudoc",
  "version": "0.3.0",
  "description": "Reusable document ASTs: validation, queries, export and loading for cross-document embedding.",
  "keywords": [
    "cudoc",
    "mdast",
    "mdx",
    "markdown",
    "ast",
    "documentation"
  ],
  "homepage": "https://github.com/cudoment/cudoc/tree/main/packages/cudoc#readme",
  "bugs": {
    "url": "https://github.com/cudoment/cudoc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cudoment/cudoc.git",
    "directory": "packages/cudoc"
  },
  "license": "MIT",
  "author": "cudoment",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ast": {
      "types": "./dist/ast.d.ts",
      "default": "./dist/ast.js"
    },
    "./syntax": {
      "types": "./dist/syntax.d.ts",
      "default": "./dist/syntax.js"
    },
    "./mdx": {
      "types": "./dist/mdx.d.ts",
      "default": "./dist/mdx.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "default": "./dist/embed.js"
    },
    "./node/export-ast": {
      "types": "./dist/node/export-ast.d.ts",
      "default": "./dist/node/export-ast.js"
    },
    "./node/load-ast-file": {
      "types": "./dist/node/load-ast-file.d.ts",
      "default": "./dist/node/load-ast-file.js"
    },
    "./node/paths": {
      "types": "./dist/node/paths.d.ts",
      "default": "./dist/node/paths.js"
    },
    "./transforms/*": {
      "types": "./dist/internal/transforms/*.d.ts",
      "default": "./dist/internal/transforms/*.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "default": "./dist/document.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./sections": {
      "types": "./dist/sections.d.ts",
      "default": "./dist/sections.js"
    },
    "./dataset": {
      "types": "./dist/dataset.d.ts",
      "default": "./dist/dataset.js"
    },
    "./node/library": {
      "types": "./dist/node/library.d.ts",
      "default": "./dist/node/library.js"
    },
    "./node/dataset": {
      "types": "./dist/node/dataset.d.ts",
      "default": "./dist/node/dataset.js"
    },
    "./node/resolve-embed": {
      "types": "./dist/node/resolve-embed.d.ts",
      "default": "./dist/node/resolve-embed.js"
    },
    "./node/storage": {
      "types": "./dist/node/storage.d.ts",
      "default": "./dist/node/storage.js"
    },
    "./node/prepare-embeds": {
      "types": "./dist/node/prepare-embeds.d.ts",
      "default": "./dist/node/prepare-embeds.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "styles.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "estree-util-value-to-estree": "^3.5.0",
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mdast-util-to-hast": "^13.2.1",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@types/mdast": "^4.0.4"
  },
  "peerDependenciesMeta": {
    "@types/mdast": {
      "optional": true
    }
  },
  "bin": {
    "cudoc": "./dist/node/cli.js"
  }
}
