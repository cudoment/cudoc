{
  "name": "cudoc-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation AST extraction and MDX syntax extensions, shared across static site generators.",
  "license": "MIT",
  "author": "cudoment",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "test": "vitest run",
    "test:run": "vitest run --project unit",
    "test:examples": "vitest run --project integration",
    "test:built": "vitest run --project built",
    "test:scripts": "node tests/scripts/rebuild-portable.mjs && node tests/scripts/rebuild-mdx.mjs && node tests/scripts/packed-consumers.mjs",
    "test:all": "npm run test && npm run test:scripts",
    "test:watch": "vitest",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lock:examples": "node scripts/refresh-example-locks.mjs"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/markdown-it-container": "^2.0.12",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "~19.2.7",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.1",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-attrs": "^4.5.0",
    "markdown-it-container": "^4.0.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "node-html-parser": "^9.0.3",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.0",
    "remark-parse": "^11.0.0",
    "typescript": "^5.7.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
