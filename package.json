{
  "name": "cudoc-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation AST extraction and MDX syntax extensions, shared across static site generators.",
  "license": "MIT",
  "author": "cudoment",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "mdast-util-mdx-jsx": "^3.2.0",
    "node-html-parser": "^9.0.3",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.0",
    "remark-parse": "^11.0.0",
    "typescript": "^5.7.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
