{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    // Deliberately not noUncheckedIndexedAccess: the transform logic was
    // written and verified under plain `strict`, and re-typing every index
    // access risks changing behaviour that the port must preserve.
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "composite": true
  }
}
