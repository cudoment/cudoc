{
  "name": "cudoc-example-docusaurus",
  "version": "0.0.0",
  "private": true,
  "description": "Docusaurus example wiring cudoc through cudoc-docusaurus.",
  "scripts": {
    "sync": "node ../scripts/sync-fixture.mjs docs/showcase.mdx && node ../scripts/sync-portable.mjs docs",
    "start": "npm run sync && npm run collect && docusaurus start",
    "build": "npm run sync && npm run collect && docusaurus build",
    "serve": "docusaurus serve",
    "clean": "rm -rf build .docusaurus .cudoc",
    "collect": "node collect.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@cudoment/cudoc": "file:../../packages/cudoc",
    "cudoc-docusaurus": "file:../../packages/cudoc-docusaurus",
    "cudoc-remark": "file:../../packages/cudoc-remark",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
