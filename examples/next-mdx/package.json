{
  "name": "cudoc-example-next-mdx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js App Router example wiring cudoc into @next/mdx.",
  "scripts": {
    "sync": "node ../scripts/sync-fixture.mjs docs/showcase.mdx",
    "dev": "npm run sync && next dev --turbopack",
    "dev:webpack": "npm run sync && next dev --webpack",
    "build": "npm run sync && next build --turbopack",
    "build:webpack": "npm run sync && next build --webpack",
    "start": "next start",
    "clean": "rm -rf .next .cudoc"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.4",
    "cudoc": "file:../../packages/cudoc",
    "cudoc-remark": "file:../../packages/cudoc-remark",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1"
  }
}
